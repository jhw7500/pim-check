[Unit]
Description=pim-check Web Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pim-check
ExecStart=/usr/bin/python3 /opt/pim-check/web.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
